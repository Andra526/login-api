# Salin jadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development

# WAJIB di production, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Masa berlaku token reset password (menit)
RESET_TOKEN_TTL_MINUTES=60

# Batas request/menit per IP untuk endpoint /auth/* (anti brute-force)
THROTTLE_AUTH_LIMIT=10
